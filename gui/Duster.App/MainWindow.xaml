<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="Duster.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Duster.App"
    Title="Duster">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="Duster"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <!-- Adding a page: one NavigationViewItem here and one entry in MainWindow._pages. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home" IsSelected="True" AutomationProperties.AutomationId="NavHome">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE80F;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Clean" Tag="clean" AutomationProperties.AutomationId="NavClean">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE74D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Restore" Tag="restore" AutomationProperties.AutomationId="NavRestore">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE81C;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Analyze" Tag="analyze" AutomationProperties.AutomationId="NavAnalyze">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xEB05;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <NavigationView.PaneFooter>
                <StackPanel
                    Margin="16,8,16,12"
                    Orientation="Horizontal"
                    Spacing="8"
                    AutomationProperties.AutomationId="EngineStatus"
                    AutomationProperties.LiveSetting="Polite"
                    AutomationProperties.Name="{x:Bind ViewModel.EngineStatus, Mode=OneWay}">
                    <FontIcon FontSize="12" Glyph="{x:Bind local:Ui.EngineGlyph(ViewModel.State), Mode=OneWay}" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind ViewModel.EngineStatus, Mode=OneWay}" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <InfoBar
                    Margin="32,12,32,0"
                    Severity="Error"
                    Title="{x:Bind ViewModel.ErrorTitle, Mode=OneWay}"
                    Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                    IsOpen="{x:Bind ViewModel.IsErrorOpen, Mode=TwoWay}"
                    AutomationProperties.AutomationId="EngineErrorBar">
                    <InfoBar.ActionButton>
                        <Button
                            Content="Restart engine"
                            Command="{x:Bind ViewModel.StartEngineCommand}"
                            AutomationProperties.AutomationId="RestartEngine" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <Frame x:Name="NavFrame" Grid.Row="1" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
