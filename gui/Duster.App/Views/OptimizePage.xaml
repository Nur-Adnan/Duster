<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.OptimizePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Duster.App"
    xmlns:vm="using:Duster.Core.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch" Spacing="12">
            <StackPanel>
                <TextBlock Style="{StaticResource PageTitleStyle}" Text="Optimize" />
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Windows maintenance tasks. Nothing runs until you choose Optimize; Preview only reads (it runs the component store analysis, if chosen)." />
            </StackPanel>

            <InfoBar
                Title="Some tasks need administrator rights"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.NeedsAdmin, Mode=OneWay}"
                Message="SSD TRIM and the component store cleanup run only when Duster runs as administrator."
                Severity="Informational"
                AutomationProperties.AutomationId="OptimizeAdminBar">
                <InfoBar.ActionButton>
                    <Button Command="{x:Bind ViewModel.RestartAsAdministratorCommand}" Content="Restart as administrator" AutomationProperties.AutomationId="OptimizeRestartAsAdmin" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Border Style="{StaticResource SectionPanelStyle}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Tasks}" AutomationProperties.Name="Optimization tasks">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:OptimizeRow">
                            <Grid Padding="0,6" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" AutomationProperties.AutomationId="{x:Bind Task.Id}" AutomationProperties.Name="{x:Bind Task.Name}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{x:Bind Task.Name}" />
                                            <FontIcon FontSize="12" Glyph="&#xE7EF;" ToolTipService.ToolTip="Needs administrator rights" Visibility="{x:Bind local:Ui.Visible(Task.AdminRequired)}" AutomationProperties.Name="Needs administrator rights" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Task.Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock Grid.Column="1" MaxWidth="360" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Outcome, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.PreviewCommand}" Content="Preview" AutomationProperties.AutomationId="OptimizePreview" />
                <Button Command="{x:Bind ViewModel.OptimizeCommand}" Content="Optimize…" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="OptimizeRun" />
                <Button Command="{x:Bind ViewModel.StopCommand}" Content="Stop" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" AutomationProperties.AutomationId="OptimizeStop" />
            </StackPanel>
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" AutomationProperties.Name="Working" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="OptimizeStatus" AutomationProperties.LiveSetting="Polite" />

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Space only Windows can reclaim" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Duster measures these and never deletes them: removing them is a Windows decision with side effects." />
            <ItemsControl ItemsSource="{x:Bind ViewModel.Reclaim}" AutomationProperties.Name="Reclaim report">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReclaimRow">
                        <Border Margin="0,4" Style="{StaticResource SectionPanelStyle}">
                            <StackPanel Spacing="4">
                                <Grid>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Item.Name}" />
                                    <TextBlock HorizontalAlignment="Right" Text="{x:Bind SizeText}" />
                                </Grid>
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" Text="{x:Bind Item.Advice}" />
                                <TextBlock Style="{StaticResource SecondaryTextStyle}" IsTextSelectionEnabled="True" Text="{x:Bind Hints}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
