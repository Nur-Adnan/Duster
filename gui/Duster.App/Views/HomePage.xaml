<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Duster.App"
    xmlns:vm="using:Duster.Core.ViewModels">

    <ScrollViewer>
        <StackPanel MaxWidth="960" Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Home" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="This PC at a glance. Duster loads it when you open Home; turn on Live to follow it." />

            <Grid Margin="0,16,0,8" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="This PC" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <ToggleSwitch
                    MinWidth="0"
                    IsOn="{x:Bind ViewModel.IsLive, Mode=TwoWay}"
                    OffContent="Live"
                    OnContent="Live"
                    AutomationProperties.AutomationId="HomeLive"
                    AutomationProperties.Name="Live refresh every 2 seconds" />
                <Button Command="{x:Bind ViewModel.CopyReportCommand}" ToolTipService.ToolTip="Copy report" AutomationProperties.Name="Copy report" AutomationProperties.AutomationId="HomeCopy">
                    <FontIcon FontSize="14" Glyph="&#xE8C8;" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.RefreshCommand}"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    ToolTipService.ToolTip="Refresh"
                    AutomationProperties.Name="Refresh"
                    AutomationProperties.AutomationId="HomeRefresh">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                </Button>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel Spacing="12">
                    <TextBlock
                        Style="{StaticResource SecondaryTextStyle}"
                        Text="Waiting for the engine…"
                        Visibility="{x:Bind local:Ui.Collapsed(ViewModel.IsConnected), Mode=OneWay}" />
                    <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsLoading), Mode=OneWay}" />
                    <InfoBar
                        Title="Could not read system status"
                        IsClosable="False"
                        IsOpen="{x:Bind local:Ui.HasText(ViewModel.LoadError), Mode=OneWay}"
                        Message="{x:Bind ViewModel.LoadError, Mode=OneWay}"
                        Severity="Warning" />

                    <Grid ColumnSpacing="24" RowSpacing="8" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.Machine), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Device" />
                        <TextBlock Grid.Column="1" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.Machine, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="Processor" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Bind ViewModel.Cpu, Mode=OneWay}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Style="{StaticResource SecondaryTextStyle}" Text="Memory" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{x:Bind ViewModel.Memory, Mode=OneWay}" />
                    </Grid>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Drives}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DriveRow">
                                <Grid Margin="0,4" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Drive}" />
                                    <ProgressBar
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Maximum="100"
                                        Value="{x:Bind UsedPercent}"
                                        AutomationProperties.Name="{x:Bind Summary}" />
                                    <TextBlock Grid.Column="2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ItemsControl ItemsSource="{x:Bind ViewModel.Details}" AutomationProperties.Name="System details">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:StatRow">
                                <Grid Padding="0,2" ColumnSpacing="24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Label}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Margin="0,16,0,8">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="Top processes" />
                <Button
                    HorizontalAlignment="Right"
                    Command="{x:Bind ViewModel.LoadProcessesCommand}"
                    Content="Sample now"
                    IsEnabled="{x:Bind ViewModel.IsConnected, Mode=OneWay}"
                    AutomationProperties.AutomationId="HomeProcesses" />
            </Grid>
            <Border Style="{StaticResource SectionPanelStyle}">
                <StackPanel Spacing="8">
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ProcessesStatus, Mode=OneWay}" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.ProcessesStatus), Mode=OneWay}" AutomationProperties.LiveSetting="Polite" />
                    <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="The busiest processes over one second. Sampled only when you ask." />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.Processes}" AutomationProperties.Name="Top processes">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:ProcessRow">
                                <Grid Padding="0,2" ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="80" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Pid}" />
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Bind Cpu}" />
                                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" Text="{x:Bind Memory}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource SectionTitleStyle}" Text="Tasks" />
            <Border Style="{StaticResource SectionPanelStyle}">
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <FontIcon VerticalAlignment="Center" Glyph="&#xE74D;" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Clean" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Remove temporary files, caches and logs." />
                    </StackPanel>
                    <Button Grid.Column="2" Command="{x:Bind ViewModel.OpenCommand}" CommandParameter="clean" Content="Open" AutomationProperties.Name="Open Clean" AutomationProperties.AutomationId="HomeOpenClean" />

                    <FontIcon Grid.Row="1" VerticalAlignment="Center" Glyph="&#xE81C;" />
                    <StackPanel Grid.Row="1" Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Restore" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Bring back items Duster set aside in the last 7 days." />
                    </StackPanel>
                    <Button Grid.Row="1" Grid.Column="2" Command="{x:Bind ViewModel.OpenCommand}" CommandParameter="restore" Content="Open" AutomationProperties.Name="Open Restore" AutomationProperties.AutomationId="HomeOpenRestore" />

                    <FontIcon Grid.Row="2" VerticalAlignment="Center" Glyph="&#xEB05;" />
                    <StackPanel Grid.Row="2" Grid.Column="1">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="Analyze" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="See which folders and files use the most space." />
                    </StackPanel>
                    <Button Grid.Row="2" Grid.Column="2" Command="{x:Bind ViewModel.OpenCommand}" CommandParameter="analyze" Content="Open" AutomationProperties.Name="Open Analyze" AutomationProperties.AutomationId="HomeOpenAnalyze" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
