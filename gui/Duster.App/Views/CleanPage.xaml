<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Duster.Core"
    xmlns:local="using:Duster.App">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Clean" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="Scan"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.AutomationId="CleanScan" />
            <Button
                Command="{x:Bind ViewModel.ScanCancelCommand}"
                Content="Cancel"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}"
                AutomationProperties.AutomationId="CleanCancel" />
        </StackPanel>

        <ProgressBar
            Grid.Row="2"
            Maximum="100"
            Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}"
            AutomationProperties.Name="Scan progress" />
        <TextBlock
            Grid.Row="3"
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="4" RowSpacing="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Column header above a ListView: WinUI has no DataGrid. -->
            <Grid Padding="12,0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="100" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="Category" />
                <TextBlock Grid.Column="1" Style="{StaticResource CaptionTextBlockStyle}" Text="Group" />
                <TextBlock Grid.Column="2" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}" Text="Size" />
            </Grid>
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Categories}"
                SelectionMode="None"
                AutomationProperties.AutomationId="CleanCategories"
                AutomationProperties.Name="Clean categories">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:CleanCategory">
                        <Grid Padding="0,8" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Name}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Description}" />
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE7EF;"
                                    ToolTipService.ToolTip="Needs administrator rights"
                                    Visibility="{x:Bind local:Ui.Visible(AdminRequired)}"
                                    AutomationProperties.Name="Needs administrator rights" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Group}" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{x:Bind local:Ui.Bytes(Bytes)}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
