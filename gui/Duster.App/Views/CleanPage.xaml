<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.CleanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Duster.App"
    xmlns:vm="using:Duster.Core.ViewModels">

    <Page.Resources>
        <!-- Source is set in code-behind to ViewModel.Groups. -->
        <CollectionViewSource x:Name="GroupedCategories" IsSourceGrouped="True" />
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Clean" />

        <InfoBar
            Grid.Row="1"
            Title="Some categories need administrator rights"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.NeedsAdmin, Mode=OneWay}"
            Message="They are listed but skipped until Duster runs as administrator."
            Severity="Informational"
            AutomationProperties.AutomationId="CleanAdminBar">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RestartAsAdministratorCommand}" AutomationProperties.AutomationId="CleanRestartAsAdmin">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE7EF;" />
                        <TextBlock Text="Restart as administrator" />
                    </StackPanel>
                </Button>
            </InfoBar.ActionButton>
        </InfoBar>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{x:Bind ViewModel.ScanCommand}" Content="Scan" AutomationProperties.AutomationId="CleanScan" />
                <Button
                    Command="{x:Bind ViewModel.ScanCancelCommand}"
                    Content="Cancel scan"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}"
                    AutomationProperties.AutomationId="CleanCancelScan" />
                <HyperlinkButton Command="{x:Bind ViewModel.SelectAllCommand}" Content="Select all" AutomationProperties.AutomationId="CleanSelectAll" />
                <HyperlinkButton Command="{x:Bind ViewModel.SelectNoneCommand}" Content="Select none" AutomationProperties.AutomationId="CleanSelectNone" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12">
                <TextBlock VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedSize, Mode=OneWay}" />
                <Button
                    Command="{x:Bind ViewModel.CleanCancelCommand}"
                    Content="Stop"
                    Visibility="{x:Bind local:Ui.Visible(ViewModel.IsCleaning), Mode=OneWay}"
                    AutomationProperties.AutomationId="CleanStop" />
                <Button Command="{x:Bind ViewModel.CleanCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="CleanRun">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE74D;" />
                        <TextBlock Text="Clean selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <ProgressBar
            Grid.Row="3"
            Maximum="100"
            Value="{x:Bind ViewModel.Progress, Mode=OneWay}"
            Visibility="{x:Bind local:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}"
            AutomationProperties.Name="Progress" />
        <TextBlock
            Grid.Row="4"
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            AutomationProperties.AutomationId="CleanStatus"
            AutomationProperties.LiveSetting="Polite" />

        <ListView
            x:Name="CategoryList"
            Grid.Row="5"
            SelectionMode="None"
            AutomationProperties.AutomationId="CleanCategories"
            AutomationProperties.Name="Clean categories">
            <ListView.GroupStyle>
                <GroupStyle>
                    <GroupStyle.HeaderTemplate>
                        <DataTemplate x:DataType="vm:CleanGroup">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Name}" />
                        </DataTemplate>
                    </GroupStyle.HeaderTemplate>
                </GroupStyle>
            </ListView.GroupStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:CleanItem">
                    <Grid Padding="0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="100" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            IsChecked="{x:Bind IsSelected, Mode=TwoWay}"
                            IsEnabled="{x:Bind CanSelect}"
                            ToolTipService.ToolTip="{x:Bind Category.Description}"
                            AutomationProperties.AutomationId="{x:Bind Category.Id}"
                            AutomationProperties.Name="{x:Bind Category.Name}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Category.Name}" TextTrimming="CharacterEllipsis" />
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE7EF;"
                                    ToolTipService.ToolTip="Needs administrator rights"
                                    Visibility="{x:Bind local:Ui.Visible(Category.AdminRequired)}"
                                    AutomationProperties.Name="Needs administrator rights" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Style="{StaticResource SecondaryTextStyle}"
                            Text="{x:Bind Outcome, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
