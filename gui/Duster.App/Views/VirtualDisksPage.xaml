<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.VirtualDisksPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Duster.App"
    xmlns:vm="using:Duster.Core.ViewModels">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Virtual disks" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="WSL 2 and Docker Desktop keep Linux in .vhdx files that grow and never shrink. Compacting returns the free space inside them to the drive; nothing inside a disk is read or changed." />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            Title="Compacting needs administrator rights"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.NeedsAdmin, Mode=OneWay}"
            Message="Disks are listed with estimates; restart Duster as administrator to compact them."
            Severity="Informational"
            AutomationProperties.AutomationId="VdiskAdminBar">
            <InfoBar.ActionButton>
                <Button Command="{x:Bind ViewModel.RestartAsAdministratorCommand}" Content="Restart as administrator" AutomationProperties.AutomationId="VdiskRestartAsAdmin" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.ScanCommand}" AutomationProperties.AutomationId="VdiskScan">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Scan again" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.StopCommand}" Content="Stop" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" AutomationProperties.AutomationId="VdiskStop" />
        </StackPanel>

        <StackPanel Grid.Row="3" Spacing="4">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsBusy), Mode=OneWay}" AutomationProperties.Name="Working" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.Status, Mode=OneWay}" AutomationProperties.AutomationId="VdiskStatus" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <ListView
            Grid.Row="4"
            ItemsSource="{x:Bind ViewModel.Disks}"
            SelectionMode="None"
            AutomationProperties.AutomationId="VdiskList"
            AutomationProperties.Name="Virtual disks">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="vm:DiskRow">
                    <Grid Padding="0,4" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                        </Grid.ColumnDefinitions>
                        <CheckBox IsChecked="{x:Bind IsSelected, Mode=TwoWay}" IsEnabled="{x:Bind CanSelect}" AutomationProperties.Name="{x:Bind Disk.Label}">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Disk.Label}" ToolTipService.ToolTip="{x:Bind Disk.Path}" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{x:Bind Detail}" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Outcome, Mode=OneWay}" />
                        <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ItemsControl Grid.Row="5" ItemsSource="{x:Bind ViewModel.Advice}" AutomationProperties.Name="Advice">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="x:String">
                    <TextBlock Margin="0,2" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind}" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="6" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.SelectedText, Mode=OneWay}" />
            <Button Grid.Column="2" Command="{x:Bind ViewModel.CompactCommand}" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="VdiskCompact">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE7EF;" />
                    <TextBlock Text="Compact selected…" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</Page>
