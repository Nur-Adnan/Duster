<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel MaxWidth="960" Padding="{StaticResource PagePadding}" HorizontalAlignment="Stretch" Spacing="4">
        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Restore" />
        <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Items Duster set aside stay restorable for 7 days." />
        <Border Margin="0,16,0,0" Style="{StaticResource SectionPanelStyle}">
            <StackPanel Spacing="8">
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="Restoring from this window is not available yet. Run this in a terminal instead:" TextWrapping="Wrap" />
                <TextBlock
                    FontFamily="Consolas"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind ViewModel.CliCommand}"
                    AutomationProperties.AutomationId="RestoreCliCommand" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
