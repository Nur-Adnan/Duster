<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.RestorePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Duster.Core"
    xmlns:local="using:Duster.App">

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource PageTitleStyle}" Text="Restore" />
            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="Items Duster set aside (purge, uninstall leftovers, old installers, Analyze) stay restorable for 7 days. Restoring never overwrites anything." />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button Command="{x:Bind ViewModel.RefreshCommand}" AutomationProperties.AutomationId="RestoreRefresh">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE72C;" />
                    <TextBlock Text="Refresh" />
                </StackPanel>
            </Button>
            <Button Command="{x:Bind ViewModel.EmptyAllCommand}" Content="Empty quarantine…" AutomationProperties.AutomationId="RestoreEmptyAll" />
        </StackPanel>

        <TextBlock
            Grid.Row="2"
            Style="{StaticResource SecondaryTextStyle}"
            Text="{x:Bind ViewModel.Status, Mode=OneWay}"
            AutomationProperties.AutomationId="RestoreStatus"
            AutomationProperties.LiveSetting="Polite" />

        <Grid Grid.Row="3" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="SessionList"
                ItemsSource="{x:Bind ViewModel.Sessions}"
                SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=OneWay}"
                SelectionChanged="SessionList_SelectionChanged"
                AutomationProperties.AutomationId="RestoreSessions"
                AutomationProperties.Name="Kept sessions">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="core:RestoreSession">
                        <StackPanel Padding="0,8" AutomationProperties.Name="{x:Bind Command}">
                            <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Command}" />
                            <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind local:Ui.SessionSummary(Created, Items.Count, Size, Damaged)}" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="8" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.SelectedTitle), Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind ViewModel.SelectedTitle, Mode=OneWay}" />
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <Button Command="{x:Bind ViewModel.RestoreSessionCommand}" Content="Restore all" Style="{StaticResource AccentButtonStyle}" AutomationProperties.AutomationId="RestoreSession" />
                    <Button Command="{x:Bind ViewModel.EmptySessionCommand}" Content="Delete for good…" AutomationProperties.AutomationId="RestoreEmptySession" />
                </StackPanel>
                <ListView
                    Grid.Row="2"
                    ItemsSource="{x:Bind ViewModel.SelectedItems, Mode=OneWay}"
                    SelectionMode="None"
                    AutomationProperties.AutomationId="RestoreItems"
                    AutomationProperties.Name="Kept items">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="core:RestoreItem">
                            <Grid Padding="0,4" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    IsTextSelectionEnabled="True"
                                    Text="{x:Bind Path}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTipService.ToolTip="{x:Bind Path}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind local:Ui.Bytes(Size)}" />
                                <Button
                                    Grid.Column="2"
                                    Click="RestoreItem_Click"
                                    Content="Restore"
                                    Tag="{x:Bind}"
                                    AutomationProperties.Name="{x:Bind local:Ui.RestoreName(Path)}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>
    </Grid>
</Page>
