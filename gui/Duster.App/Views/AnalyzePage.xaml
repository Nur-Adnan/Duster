<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Duster.App.Views.AnalyzePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:core="using:Duster.Core"
    xmlns:local="using:Duster.App"
    xmlns:vm="using:Duster.Core.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="RowTemplate" x:DataType="vm:AnalyzeRow">
            <Grid Padding="0,4" ColumnSpacing="16" AutomationProperties.Name="{x:Bind Item.Name}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="90" />
                </Grid.ColumnDefinitions>
                <FontIcon VerticalAlignment="Center" FontSize="16" Glyph="{x:Bind local:Ui.ItemGlyph(Item.IsDir)}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{x:Bind Item.Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTipService.ToolTip="{x:Bind Item.Path}" />
                <ProgressBar Grid.Column="2" VerticalAlignment="Center" Maximum="100" Value="{x:Bind Percent}" AutomationProperties.Name="Share of this folder" />
                <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{x:Bind SizeText}" />
                <TextBlock Grid.Column="4" HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Detail}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid Padding="{StaticResource PagePadding}" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource PageTitleStyle}" Text="Analyze" />

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                Header="Folder or drive"
                Text="{x:Bind ViewModel.Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.AutomationId="AnalyzePath" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Command="{x:Bind ViewModel.BrowseCommand}" Content="Browse…" AutomationProperties.AutomationId="AnalyzeBrowse" />
            <Button
                Grid.Column="2"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ScanCommand}"
                Content="Scan"
                Style="{StaticResource AccentButtonStyle}"
                AutomationProperties.AutomationId="AnalyzeScan" />
            <Button
                Grid.Column="3"
                VerticalAlignment="Bottom"
                Command="{x:Bind ViewModel.ScanCancelCommand}"
                Content="Cancel"
                Visibility="{x:Bind local:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}"
                AutomationProperties.AutomationId="AnalyzeCancel" />
        </Grid>

        <StackPanel Grid.Row="2" Spacing="4">
            <ProgressBar IsIndeterminate="True" Visibility="{x:Bind local:Ui.Visible(ViewModel.IsScanning), Mode=OneWay}" AutomationProperties.Name="Scanning" />
            <TextBlock
                Style="{StaticResource SecondaryTextStyle}"
                Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                AutomationProperties.AutomationId="AnalyzeStatus"
                AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <BreadcrumbBar
            x:Name="TrailBar"
            Grid.Row="3"
            ItemClicked="Trail_ItemClicked"
            ItemsSource="{x:Bind ViewModel.Trail}"
            AutomationProperties.AutomationId="AnalyzeTrail">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate x:DataType="core:AnalyzeFolder">
                    <BreadcrumbBarItem AutomationProperties.Name="{x:Bind Name}" Content="{x:Bind Name}" />
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <SelectorBar x:Name="ViewSelector" Grid.Row="4" SelectionChanged="Views_SelectionChanged">
            <SelectorBarItem x:Name="FolderView" IsSelected="True" Text="Folder" AutomationProperties.AutomationId="AnalyzeFolderView" />
            <SelectorBarItem x:Name="LargestView" Text="Largest files" AutomationProperties.AutomationId="AnalyzeLargestView" />
            <SelectorBarItem x:Name="ChangesView" Text="Changes" AutomationProperties.AutomationId="AnalyzeChangesView" />
        </SelectorBar>

        <Grid Grid.Row="5">
            <Grid x:Name="FolderPanel" RowSpacing="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ListView
                    x:Name="EntryList"
                    IsItemClickEnabled="True"
                    ItemClick="EntryList_ItemClick"
                    ItemTemplate="{StaticResource RowTemplate}"
                    ItemsSource="{x:Bind ViewModel.Entries}"
                    SelectionChanged="Rows_SelectionChanged"
                    SelectionMode="Single"
                    AutomationProperties.AutomationId="AnalyzeEntries"
                    AutomationProperties.Name="Folder contents, largest first. Activate a folder to open it." />
                <TextBlock Grid.Row="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.MoreText, Mode=OneWay}" Visibility="{x:Bind local:Ui.VisibleIfText(ViewModel.MoreText), Mode=OneWay}" />
            </Grid>
            <ListView
                x:Name="LargestList"
                ItemTemplate="{StaticResource RowTemplate}"
                ItemsSource="{x:Bind ViewModel.Largest}"
                SelectionChanged="Rows_SelectionChanged"
                SelectionMode="Single"
                Visibility="Collapsed"
                AutomationProperties.AutomationId="AnalyzeLargest"
                AutomationProperties.Name="Largest files in this folder" />
            <Grid x:Name="ChangesPanel" RowSpacing="8" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind ViewModel.ChangesSummary, Mode=OneWay}" />
                <ListView
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Changes}"
                    SelectionMode="None"
                    AutomationProperties.AutomationId="AnalyzeChanges"
                    AutomationProperties.Name="Changes since the last scan">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChangeRow">
                            <Grid Padding="0,4" ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Entry.Path}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Entry.Path}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource SecondaryTextStyle}" Text="{x:Bind Text}" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Grid>

        <Button Grid.Row="6" Command="{x:Bind ViewModel.RecycleCommand}" AutomationProperties.AutomationId="AnalyzeRecycle">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon FontSize="14" Glyph="&#xE74D;" />
                <TextBlock Text="Move to Recycle Bin…" />
            </StackPanel>
        </Button>
    </Grid>
</Page>
